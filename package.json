{
  "name": "autumnflow",
  "version": "0.1.14",
  "description": "AutumnFlow（秋水）— universal ACP agent workbench",
  "homepage": "https://github.com/yitom486/autumnflow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yitom486/autumnflow.git"
  },
  "bugs": {
    "url": "https://github.com/yitom486/autumnflow/issues"
  },
  "author": {
    "name": "yitom486",
    "email": "yitom486@gmail.com"
  },
  "type": "module",
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "com.autumnflow.app",
    "productName": "AutumnFlow",
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "node_modules/node-pty/package.json",
      "node_modules/node-pty/lib/**/*",
      "node_modules/node-pty/prebuilds/**/*",
      "node_modules/node-pty/build/Release/**/*",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/**/*.map",
      "!node_modules/node-pty/**/*.test.js"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "AutumnFlow-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "AutumnFlow-${version}-${arch}-mac.${ext}",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons",
      "artifactName": "AutumnFlow-${version}.${ext}"
    },
    "directories": {
      "app": ".acp-tmp/desktop-app",
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "**/*.node",
      "node_modules/node-pty/**/*",
      "electron-dist/host.cjs"
    ],
    "npmRebuild": false,
    "electronLanguages": ["en-US", "zh-CN", "zh-TW"],
    "publish": [
      {
        "provider": "github",
        "owner": "yitom486",
        "repo": "autumnflow",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AutumnFlow-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutumnFlow",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "menuCategory": false,
      "uninstallDisplayName": "AutumnFlow"
    },
    "dmg": {
      "artifactName": "AutumnFlow-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "autumnflow_${version}_${arch}.${ext}"
    },
    "icon": "build/icon.png"
  },
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,green\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:desktop": "bun desktop/dev.ts",
    "clean": "bun scripts/clean-desktop.ts",
    "clean:desktop": "bun scripts/clean-desktop.ts",
    "dev:server": "bun --watch server/index.ts --development",
    "dev:server:node": "bun build server/node.ts --target=node --outdir=.tmp-node && node .tmp-node/node.js --development",
    "dev:client": "vite",
    "acp:stdio": "bunx @yitom/agy-acp-map@latest",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.desktop.json",
    "build:electron": "bun desktop/build.ts",
    "stage:desktop": "bun desktop/stage.ts",
    "package:win": "bun desktop/stage.ts win32 && bunx electron-builder --win nsis dir --publish never",
    "package:mac": "bun desktop/stage.ts darwin && bunx electron-builder --mac dmg zip --publish never",
    "package:linux": "bun desktop/stage.ts linux && bunx electron-builder --linux AppImage deb --publish never",
    "start:electron": "electron electron-dist/main.cjs",
    "dev:electron": "ELECTRON_DEV=1 ELECTRON_START_URL=http://localhost:5188 electron electron-dist/main.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release:patch": "bun scripts/release.ts patch",
    "release:minor": "bun scripts/release.ts minor",
    "release:major": "bun scripts/release.ts major",
    "release:notes": "bun scripts/release-notes.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@assistant-ui/react": "^0.15.27",
    "@assistant-ui/react-markdown": "^0.14.20",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@jupyterlab/nbformat": "^4.5.11",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@shikijs/transformers": "^4.4.3",
    "@tanstack/react-query": "^5.103.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@yitom/acp-client": "^0.1.14",
    "ajv": "latest",
    "ajv-formats": "latest",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.4.0",
    "hono": "^4.13.8",
    "katex": "^0.19.0",
    "lucide-react": "^0.475.0",
    "mermaid": "^12.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-arborist": "^4.0.1",
    "react-dnd": "16",
    "react-dnd-html5-backend": "16",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "bun-types": "^1.4.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
}
